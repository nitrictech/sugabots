{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!**/*.svg",
			"!packages/core/drizzle",
			"!packages/web/.storybook/public/mockServiceWorker.js",
			"!packages/website/src/routeTree.gen.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/**/src/**/*.workflow.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"node:*",
											"pg",
											"@effect/sql-pg",
											"@effect/platform-node",
											"**/database/**"
										],
										"message": "Workflow modules run inside Temporal's sandbox: import only schemas and step-service tags, and reach the database, the network or Node through a step service."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"packages/web/src/ui/dialog.tsx",
				"packages/web/src/ui/dropdown-menu.tsx",
				"packages/web/src/ui/select.tsx",
				"packages/web/src/ui/textarea.tsx",
				"packages/website/src/components/ui/item.tsx"
			],
			"linter": {
				"enabled": false
			}
		}
	]
}
