				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@sugabots/bot-loop", "@sugabots/bot-loop/*"],
										"message": "Core starts turns without knowing the bot loop: it declares the services that start, steer and interrupt turns, and the server provides them from `@sugabots/bot-loop`."
									}
								]
							}
						}
					}
				}
			}
