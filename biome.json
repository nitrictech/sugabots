{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!**/*.svg",
			"!docker/computer/theme",
			"!packages/core/drizzle",
			"!packages/web/.storybook/public/mockServiceWorker.js",
			"!packages/website/src/routeTree.gen.ts",
			"!packages/emoji/src/emoji.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/web/src/**/*.{ts,tsx}", "packages/website/src/**/*.{ts,tsx}"],
			"plugins": ["./lint/no-fixed-tailwind-values.grit"]
		},
		{
			"includes": [
				"packages/core/src/providers/connectors/github/**/*.ts",
				"packages/core/src/providers/models/**/*.ts",
				"packages/core/src/providers/model-providers/remote.ts",
				"packages/core/src/operations/**/*.ts",
				"packages/contracts/src/errors/**/*.ts",
				"packages/server/src/http/errors.ts"
			],
			"plugins": [
				"./lint/errors-implement-domain-error.grit",
				"./lint/no-effect-promise.grit",
				"./lint/no-unchecked-user-text.grit"
			]
		},
		{
			"includes": [
				"packages/**/src/**",
				"!packages/core/src/chats/turns/**",
				"!**/*.test.ts",
				"!**/*.test.tsx",
				"!**/testing.ts",
				"!**/*.test-support.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/turns/**", "!**/turns/turns", "!**/turns/turns.ts"],
										"message": "Outside `chats/turns/`, import the Turns module only through `turns/turns.ts`; its other files are internal."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"packages/**/src/**/*.test.ts",
				"packages/**/src/**/*.test.tsx",
				"packages/**/src/**/testing.ts",
				"packages/**/src/**/*.test-support.ts",
				"!packages/core/src/chats/turns/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"**/turns/**",
											"!**/turns/turns",
											"!**/turns/turns.ts",
											"!**/turns/testing",
											"!**/turns/testing.ts"
										],
										"message": "Outside `chats/turns/`, a test imports the Turns module only through `turns/turns.ts` or `turns/testing.ts`."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/**/src/**/*.workflow.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"node:*",
											"pg",
											"@effect/sql-pg",
											"@effect/platform-node",
											"**/database/**"
										],
										"message": "Workflow modules hold only definitions, which the engine replays: import only schemas and step-service tags, and reach the database, the network or Node through a step service."
									},
									{
										"group": ["**/turns/**", "!**/turns/turns", "!**/turns/turns.ts"],
										"message": "Outside `chats/turns/`, import the Turns module only through `turns/turns.ts`; its other files are internal."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/**/src/**/*.{ts,tsx}", "!packages/core/src/proofs/**"],
			"plugins": ["./lint/proofs-only-in-proofs.grit"]
		},
		{
			"includes": ["packages/**/src/**/*.{ts,tsx}", "!packages/core/src/proofs/proof.ts"],
			"plugins": ["./lint/no-proof-assertion.grit"]
		},
		{
			"includes": [
				"packages/core/src/proofs/**/*.ts",
				"packages/core/src/authentication/**/*.ts",
				"packages/core/src/operations/**/*.ts",
				"packages/core/src/principal.ts",
				"packages/core/src/tiers.ts",
				"packages/bot-loop/src/**/*.ts",
				"packages/contracts/src/operations/**/*.ts",
				"packages/contracts/src/errors/**/*.ts",
				"!packages/core/src/proofs/proof.ts"
			],
			"plugins": ["./lint/no-double-assertion.grit"]
		},
		{
			"includes": ["packages/**/src/**/*.{ts,tsx}", "!packages/core/src/authentication/**"],
			"plugins": ["./lint/principals-only-in-authentication.grit"]
		},
		{
			"includes": [
				"packages/core/src/**/*.ts",
				"!**/*.test.ts",
				"!**/*.test-support.ts",
				"!**/testing.ts",
				"!packages/core/src/database/test-*.ts"
			],
			"plugins": ["./lint/no-module-state.grit"]
		},
		{
			"includes": [
				"packages/core/src/operations/**",
				"packages/bot-loop/src/**",
				"packages/contracts/src/**",
				"packages/sdk/src/**",
				"packages/web/src/**",
				"!**/*.test.ts",
				"!**/*.test.tsx",
				"!**/testing.ts",
				"!**/*.test-support.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"**/database/database",
											"**/database/database.ts",
											"**/database/schema",
											"**/database/schema.ts",
											"**/sql",
											"**/sql.ts",
											"drizzle-orm",
											"drizzle-orm/*"
										],
										"message": "Only services reach the database. Call a service, which takes the proofs it needs."
									},
									{
										"group": [
											"**/turns/**",
											"!**/turns/turns",
											"!**/turns/turns.ts",
											"!./turns/index.ts"
										],
										"message": "Outside `chats/turns/`, import the Turns module only through `turns/turns.ts`; its other files are internal. (`./turns/index.ts` in `operations/` is the turns domain's operations.)"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"packages/web/src/ui/dialog.tsx",
				"packages/web/src/ui/dropdown-menu.tsx",
				"packages/web/src/ui/textarea.tsx"
			],
			"linter": {
				"enabled": false
			}
		}
	]
}
