# Copy to .env. The API, the web app, the Drizzle CLI and the tests all read
# this one file.

# Postgres from compose.yml, as seen from the host.
DATABASE_URL=postgresql://sugabots:sugabots@localhost:5436/sugabots
# Optional, 10 unless set. The most connections the API's main pool opens;
# sign-in holds up to 2 more. Lower it when the database's max_connections is
# small, as on a hosted plan that reserves slots for its own services.
# DATABASE_POOL_SIZE=10
# Optional. A direct connection to Postgres, for when DATABASE_URL goes through
# a transaction pooler such as PgBouncer. The workflow engine's locks and
# live-update LISTEN use it, in a pool of up to 6 connections. Left
# unset, DATABASE_URL is taken to be direct and used for everything.
# DATABASE_DIRECT_URL=
# Optional. The tests never share the database above: they write rows and queue
# jobs a running dev server would try to claim, and each run starts by emptying
# whatever they are pointed at. Left unset, "_test" is appended to the name
# above and that database is created and migrated on the first run.
# TEST_DATABASE_URL=postgresql://sugabots:sugabots@localhost:5436/sugabots_test

# API. NODE_ENV is development (the default), production or test. These values make `bun run dev` work
# as supplied. The port below is what the API binds when it is started on its
# own; under `bun run dev` Portless assigns it a port and overrides this.
# NODE_ENV=production
PORT=3000
# Where the web app is served, when it is hosted apart from the API. Invite
# links and connection sign-ins return here, and its origin may call the API
# with a cookie. Defaults to PUBLIC_URL.
# WEB_APP_URL=

# Signing key for sessions and tokens. Generate with `openssl rand -base64 32`.
# Changing it signs everybody out.
BETTER_AUTH_SECRET=development-secret-not-for-production
# Development-only key. Generate a different value with `openssl rand -base64 32`.
# Seals every stored credential: model and search provider keys, connection
# secrets, and connection sign-ins.
CREDENTIALS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Whether model providers may be reached over plain HTTP or at private
# addresses (localhost, your LAN). This is the installation's call, not a
# workspace's: on a self-hosted install the network is yours, so leave it on
# and Ollama, LM Studio, vLLM and the like work at their local addresses; on an
# installation serving other people's workspaces, keep it off so a workspace
# cannot point a provider at your network. Unset, it is on in development and
# off in production.
# ALLOW_PRIVATE_MODEL_PROVIDER_NETWORK=true
# Whether an agent's web_fetch tool may read pages at private addresses. Off
# everywhere unless set: a model server on this machine is normal, an agent
# reading this machine's other services is not. Turn it on for a self-hosted
# install whose agents should read an intranet.
# ALLOW_PRIVATE_WEB_FETCH_NETWORK=true
# Where a browser reaches the API, without its /api path. Links in emails and
# OAuth redirects start here, so it must not be a container-internal address.
# In development this is Vite under Portless, which proxies /api to the API.
PUBLIC_URL=https://sugabots.localhost
# Who may create an account: `closed` unless set, where nobody signs themselves
# up and people arrive by invitation to a workspace (except the first account on
# a new installation); `referral`, which also admits anybody with a member's
# referral link; or `open`. Development wants it open, so a throwaway account works.
SIGNUP_MODE=open
# Whether a new account must open a link in its inbox before it gets a
# session. Off unless set, so a self-hoster is not made to stand up a mail
# service before they can sign in. With the console provider the link is
# printed to the server's console.
# REQUIRE_EMAIL_VERIFICATION=true
# How email is sent: console (the default, which prints each email to the
# server's log instead of sending it), webhook or resend.
# EMAIL_PROVIDER=webhook
# For EMAIL_PROVIDER=webhook. The endpoint receives each email as JSON: from,
# to, cc, bcc and replyTo as {email, name} addresses, subject, and text and/or
# html. EMAIL_WEBHOOK_URL must use HTTPS in production.
# EMAIL_WEBHOOK_URL=https://mailer.example.com/sugabots
# EMAIL_WEBHOOK_TOKEN=
# For EMAIL_PROVIDER=resend. An API key with permission to send, from
# https://resend.com/api-keys.
# EMAIL_RESEND_API_KEY=
# The sender of emails a user's own action triggers, such as verification and
# invitations. Required in production, and must be one your provider accepts.
# EMAIL_TRANSACTIONAL_FROM=Sugabots <no-reply@example.com>

# Tracing. With an endpoint set, the API exports its traces and logs over
# OTLP/HTTP to any collector; without one it exports nothing. A hosted
# backend's API key goes in OTEL_EXPORTER_OTLP_HEADERS. Every response carries
# a Server-Timing header with its duration and trace id either way.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp

# Web. Vite inlines anything prefixed VITE_ into the bundle, so nothing secret
# goes here. Where the API is, path included. Unset, /api of the page's own
# origin; set it when the web app is hosted apart from the API.
# VITE_API_URL=
