# Copy to .env. The API, the web app, the Drizzle CLI and the tests all read
# this one file.

# Postgres from compose.yml, as seen from the host.
DATABASE_URL=postgresql://sugabots:sugabots@localhost:5436/sugabots
# Optional. The tests never share the database above: they write rows and queue
# jobs a running dev server would try to claim, and each run starts by emptying
# whatever they are pointed at. Left unset, "_test" is appended to the name
# above and that database is created and migrated on the first run.
# TEST_DATABASE_URL=postgresql://sugabots:sugabots@localhost:5436/sugabots_test

# API. NODE_ENV defaults to development. These values make `bun run dev` work
# as supplied. The port below is what the API binds when it is started on its
# own; under `bun run dev` Portless assigns it a port and overrides this.
# NODE_ENV=production
PORT=3000
# Browser origins besides BETTER_AUTH_URL's that may call the API with a
# cookie. Comma-separated; the first is where invite links point. Set this
# when the web app is hosted apart from the API.
# WEB_ORIGIN=

# Signing key for sessions and tokens. Generate with `openssl rand -base64 32`.
# Changing it signs everybody out.
BETTER_AUTH_SECRET=development-secret-not-for-production
# Development-only key. Generate a different value with `openssl rand -base64 32`.
# Seals every stored credential: model provider keys and search provider keys.
MODEL_PROVIDER_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Whether model providers may be reached over plain HTTP or at private
# addresses (localhost, your LAN). This is the installation's call, not a
# workspace's: on a self-hosted install the network is yours, so leave it on
# and Ollama, LM Studio, vLLM and the like work at their local addresses; on an
# installation serving other people's workspaces, keep it off so a workspace
# cannot point a provider at your network. Unset, it is on in development and
# off in production.
# ALLOW_PRIVATE_MODEL_PROVIDER_NETWORK=true
# Whether an agent's web_fetch tool may read pages at private addresses. Off
# everywhere unless set: a model server on this machine is normal, an agent
# reading this machine's other services is not. Turn it on for a self-hosted
# install whose agents should read an intranet.
# ALLOW_PRIVATE_WEB_FETCH_NETWORK=true
# Where a browser reaches the API, without its /api path. Links in emails and
# OAuth redirects start here, so it must not be a container-internal address.
# In development this is Vite under Portless, which proxies /api to the API.
BETTER_AUTH_URL=https://sugabots.localhost
# Whether anybody may create an account. Off unless set: the first person to
# arrive owns the installation, and after that the only way in is an invitation
# from a member. Development wants it on, so a throwaway account works.
ALLOW_OPEN_SIGNUP=true
# Whether a new account must open a link in its inbox before it gets a
# session. Off unless set, so a self-hoster is not made to stand up a mail
# service before they can sign in. Needs EMAIL_WEBHOOK_URL: the server refuses
# to start if it is on with only the console mailer behind it.
# REQUIRE_EMAIL_VERIFICATION=true
# Required in production. The endpoint receives {to, subject, text} as JSON.
# EMAIL_WEBHOOK_URL=https://mailer.example.com/sugabots
# EMAIL_WEBHOOK_TOKEN=

# Tracing. Unset, nothing is exported, though every response still carries a
# Server-Timing header with its duration and trace id. These send traces and
# Effect logs to the Jaeger in compose.yml (http://localhost:16686). Any OTLP/HTTP
# backend works; OTEL_EXPORTER_OTLP_HEADERS carries its API key.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp

# Web. Vite inlines anything prefixed VITE_ into the bundle, so nothing secret
# goes here. Where the API is, path included. Unset, /api of the page's own
# origin; set it when the web app is hosted apart from the API.
# VITE_API_URL=
