{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sugabots-website",
	"compatibility_date": "2026-09-25",
	// The site is prerendered. The Worker serves the built files, Markdown to agents that ask for it,
	// and the site's redirects.
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		// Only pages and redirects need the Worker. A path with a dot is a file, such as a script, an
		// image or llms.txt, and is served straight from the assets.
		"run_worker_first": ["/*", "!/*.*"],
		// An address with no file gets the prerendered 404.html, with a 404 status, whether it was
		// asked for directly or through the Worker's `ASSETS` binding.
		"not_found_handling": "404-page"
	},
	// `wrangler preview` (preview builds) requires this block; the settings above apply to previews too.
	"previews": {}
}
