{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "mdx"],
		"jsx": "react-jsx",

		/* `@/` as shadcn/ui writes it. Vite resolves it through `tsconfigPaths`. */
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src", "scripts", "vite.config.ts"]
}
