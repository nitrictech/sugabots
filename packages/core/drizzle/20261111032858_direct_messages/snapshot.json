      "key": "checks\u0000[\"public\",\"thread\",\"thread_host_valid\"]",
      "set": {
        "value": "case \"type\" when 'pod_chat' then \"host_agent_id\" is null when 'direct' then \"host_agent_id\" is null when 'conversation' then true else \"host_agent_id\" is not null end"
