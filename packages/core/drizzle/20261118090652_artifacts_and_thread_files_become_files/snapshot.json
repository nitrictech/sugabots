      "op": "create",
      "row": {
        "schema": "public",
        "table": "file",
        "name": "file_kind_valid",
        "value": "\"kind\" in ('document', 'html', 'upload', 'agent_attachment', 'tool_result')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "file",
        "name": "file_source_valid",
        "value": "case \"kind\"\n\t\t\t\twhen 'upload' then \"name\" is not null and \"content_type\" is not null\n\t\t\t\t\tand \"size\" is not null and \"tool_call_id\" is null\n\t\t\t\t\tand (\"message_id\" is null) = (\"position\" is null)\n\t\t\t\t\tand \"created_by_agent_id\" is null and \"current_version\" is null\n\t\t\t\twhen 'agent_attachment' then \"name\" is not null and \"content_type\" is not null\n\t\t\t\t\tand \"size\" is not null and \"tool_call_id\" is null\n\t\t\t\t\tand \"uploader_id\" is null and \"message_id\" is not null\n\t\t\t\t\tand \"position\" is not null\n\t\t\t\t\tand \"created_by_agent_id\" is null and \"current_version\" is null\n\t\t\t\twhen 'tool_result' then \"name\" is null and \"content_type\" is not null\n\t\t\t\t\tand \"size\" is not null and \"uploader_id\" is null\n\t\t\t\t\tand \"message_id\" is null and \"position\" is null\n\t\t\t\t\tand \"created_by_agent_id\" is null and \"current_version\" is null\n\t\t\t\telse \"name\" is not null and \"current_version\" is not null\n\t\t\t\t\tand \"content_type\" is null and \"size\" is null\n\t\t\t\t\tand \"tool_call_id\" is null and \"uploader_id\" is null\n\t\t\t\t\tand \"message_id\" is null and \"position\" is null\n\t\t\tend",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
