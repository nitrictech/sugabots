	"// withRepeat": "The third argument is the local date-time it happens at, which the new schedule counts from and a monthly one takes its day from.",
	"withRepeat": [
		{
			"given": [
				{
					"kind": "picked",
					"schedule": {
						"repeat": "daily",
						"every": 3,
						"times": [540, 1020],
						"startsOn": "2026-01-05"
					}
				},
				"weekly",
				"2026-03-10T08:00"
			],
			"expect": {
				"repeat": "weekly",
				"every": 1,
				"days": ["mon"],
				"times": [540, 1020],
				"startsOn": "2026-03-10"
			}
		},
		{
