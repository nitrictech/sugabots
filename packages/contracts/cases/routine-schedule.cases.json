						"startsOn": "2026-01-05"
					}
				},
				"weekly",
				"2026-03-10T08:00"
			],
			"expect": {
				"repeat": "weekly",
				"every": 1,
				"days": ["tue", "thu"],
				"times": [600],
				"startsOn": "2026-03-10"
