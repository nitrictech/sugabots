{
	"splitAroundMentions": [
		{ "given": ["No mentions here."], "expect": ["No mentions here."] },
		{ "given": ["@ada can you look?"], "expect": ["", "ada", " can you look?"] },
		{
			"given": ["Ask @scout and @ops-bot, then @Ada."],
			"expect": ["Ask ", "scout", " and ", "ops-bot", ", then ", "Ada", "."]
		},
		{
			"given": ["mail ada@example.com or @ada"],
			"expect": ["mail ada@example.com or ", "ada", ""]
		},
		{ "given": ["see example.@ada and @@ada"], "expect": ["see example.@ada and @@ada"] },
		{
			"given": ["(@ada) [@grace] \"@scout\" @ada:"],
			"expect": ["(", "ada", ") [", "grace", "] \"", "scout", "\" ", "ada", ":"]
		},
		{ "given": ["@ada-"], "expect": ["", "ada", "-"] },
		{ "given": ["@ada--b @a-b-c @-ada"], "expect": ["", "ada", "--b ", "a-b-c", " @-ada"] },
		{ "given": ["@ada_lovelace"], "expect": ["", "ada", "_lovelace"] },
		{ "given": ["line\n@ada\n@grace"], "expect": ["line\n", "ada", "\n", "grace", ""] },
		{ "given": ["café@ada é@ada"], "expect": ["café", "ada", " é", "ada", ""] },
		{ "given": ["@zoé is here"], "expect": ["", "zoe", "́ is here"] },
		{ "given": ["@Kelvin @ſam"], "expect": ["@Kelvin @ſam"] },
		{ "given": ["@ here and @"], "expect": ["@ here and @"] },
		{ "given": ["@here @channel please"], "expect": ["", "here", " ", "channel", " please"] }
	],
