<?xml version="1.0" encoding="UTF-8"?>
<!-- Openbox for a desktop's display, whose windows the web app draws a frame
     around, one each: no window has a frame or border of its own. The
     desktop server places them. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme><keepBorder>no</keepBorder></theme>
  <desktops><number>1</number></desktops>
  <applications>
    <application class="*">
      <decor>no</decor>
    </application>
  </applications>
</openbox_config>
