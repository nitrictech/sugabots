<?xml version="1.0" encoding="UTF-8"?>
<!-- The window manager: the Sugabots frames sugabots-desktop-look draws in
     the agent's colour, one workspace, and xfwm4's own compositor for
     shadows, the frames' round corners and the dock's see-through bar. -->
<channel name="xfwm4" version="1.0">
	<property name="general" type="empty">
		<property name="theme" type="string" value="Sugabots"/>
		<property name="title_font" type="string" value="Inter Semi-Bold 9"/>
		<property name="title_alignment" type="string" value="center"/>
		<property name="button_layout" type="string" value="|HMC"/>
		<property name="workspace_count" type="int" value="1"/>
		<property name="use_compositing" type="bool" value="true"/>
		<property name="vblank_mode" type="string" value="off"/>
		<property name="show_frame_shadow" type="bool" value="true"/>
		<property name="show_popup_shadow" type="bool" value="true"/>
		<property name="show_dock_shadow" type="bool" value="false"/>
		<property name="frame_opacity" type="int" value="100"/>
		<property name="zoom_desktop" type="bool" value="false"/>
		<property name="cycle_preview" type="bool" value="false"/>
		<property name="placement_mode" type="string" value="center"/>
		<property name="placement_ratio" type="int" value="100"/>
		<!-- A maximised window stops 8px above the dock, which floats free of
		     the edge and so reserves no space of its own. -->
		<property name="margin_bottom" type="int" value="84"/>
	</property>
</channel>
