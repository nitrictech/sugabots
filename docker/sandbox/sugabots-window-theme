#!/bin/bash
# Draws the Sugabots window theme for xfwm4 into `directory`/xfwm4: dark title
# bars with rounded top corners, a 2px edge in `accent` round the focused
# window, and macOS-style traffic lights on the left that show their glyph
# under the pointer. Drawn as SVG and rendered to PNG so the curves are
# antialiased.
#
#   sugabots-window-theme accent directory
#
# The image draws the default theme with it, and `sugabots-desktop` a copy for
# each desktop given its own accent.
set -euo pipefail

accent="${1:?accent colour, #RRGGBB}"
out="${2:?theme directory}/xfwm4"
mkdir -p "$out"

title_px=32
radius_px=10
edge_px=2
inactive_edge="#23252c"
active_title="#15161a"
inactive_title="#111216"

render() {
	local name="$1" width="$2" height="$3" content="$4"
	printf '<svg xmlns="http://www.w3.org/2000/svg" width="%s" height="%s">%s</svg>' \
		"$width" "$height" "$content" |
		rsvg-convert --width "$width" --height "$height" --output "$out/$name.png"
}

# A frame's pieces for one state: the edge colour, with the title bar inside it.
frame() {
	local state="$1" edge="$2" title="$3"
	# The rounded top-left corner, mirrored for the right: an edged rounded
	# rectangle seen through a window as big as the corner.
	local corner="<rect width=\"40\" height=\"80\" rx=\"$radius_px\" fill=\"$edge\"/><rect x=\"$edge_px\" y=\"$edge_px\" width=\"40\" height=\"80\" rx=\"$((radius_px - edge_px))\" fill=\"$title\"/>"
	render "top-left-$state" 12 "$title_px" "$corner"
	render "top-right-$state" 12 "$title_px" "<g transform=\"translate(12 0) scale(-1 1)\">$corner</g>"
	local strip="<rect width=\"1\" height=\"$title_px\" fill=\"$title\"/><rect width=\"1\" height=\"$edge_px\" fill=\"$edge\"/>"
	for part in 1 2 3 4 5; do render "title-$part-$state" 1 "$title_px" "$strip"; done
	local side="<rect width=\"$edge_px\" height=\"1\" fill=\"$edge\"/>"
	render "left-$state" "$edge_px" 1 "$side"
	render "right-$state" "$edge_px" 1 "$side"
	render "bottom-$state" 1 "$edge_px" "<rect width=\"1\" height=\"$edge_px\" fill=\"$edge\"/>"
	render "bottom-left-$state" "$edge_px" "$edge_px" "<rect width=\"$edge_px\" height=\"$edge_px\" fill=\"$edge\"/>"
	render "bottom-right-$state" "$edge_px" "$edge_px" "<rect width=\"$edge_px\" height=\"$edge_px\" fill=\"$edge\"/>"
}

# A traffic light in each state xfwm4 draws, its glyph shown under the pointer
# and when pressed. Drawn on its title bar and edge rather than see-through:
# without a compositor of its own, xfwm4 cuts transparency to a one-bit mask,
# which would undo the antialiasing.
button() {
	local name="$1" colour="$2" pressed="$3" glyph="$4"
	local light="<circle cx=\"10\" cy=\"$((title_px / 2))\" r=\"6\""
	local mark="<g transform=\"translate(10 $((title_px / 2)))\" stroke=\"#000\" stroke-opacity=\"0.55\" stroke-width=\"1.3\" stroke-linecap=\"round\" fill=\"none\">$glyph</g>"
	local active="<rect width=\"20\" height=\"$title_px\" fill=\"$active_title\"/><rect width=\"20\" height=\"$edge_px\" fill=\"$accent\"/>"
	local inactive="<rect width=\"20\" height=\"$title_px\" fill=\"$inactive_title\"/><rect width=\"20\" height=\"$edge_px\" fill=\"$inactive_edge\"/>"
	render "$name-active" 20 "$title_px" "$active$light fill=\"$colour\"/>"
	render "$name-inactive" 20 "$title_px" "$inactive$light fill=\"#3a3d45\"/>"
	render "$name-prelight" 20 "$title_px" "$active$light fill=\"$colour\"/>$mark"
	render "$name-pressed" 20 "$title_px" "$active$light fill=\"$pressed\"/>$mark"
}

frame active "$accent" "$active_title"
frame inactive "$inactive_edge" "$inactive_title"
button close "#ff5f57" "#d9443d" '<path d="M-2.5 -2.5L2.5 2.5M2.5 -2.5L-2.5 2.5"/>'
button hide "#febc2e" "#d99b1c" '<path d="M-3 0H3"/>'
button maximize "#28c840" "#1ea533" '<path d="M-3 0H3M0 -3V3"/>'
button maximize-toggled "#28c840" "#1ea533" '<path d="M-3 0H3M0 -3V3"/>'

cat >"$out/themerc" <<EOF
active_text_color=#eceef2
inactive_text_color=#7d838e
button_offset=6
button_spacing=0
full_width_title=true
title_vertical_offset_active=1
title_vertical_offset_inactive=1
shadow_delta_height=10
shadow_delta_width=10
shadow_delta_x=-5
shadow_delta_y=-2
shadow_opacity=45
EOF
