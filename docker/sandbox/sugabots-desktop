#!/bin/bash
# Desktops in this sandbox, each on its own display, so agents working at the
# same time never click on each other's windows.
#
#   sugabots-desktop start [display]               start a bare desktop, print its DISPLAY
#   sugabots-desktop stop display                  stop it, and its browser
#   sugabots-desktop desktop name profile output [claimant]   the desktop for `name`, without a browser
#   sugabots-desktop session name profile output [claimant]   the desktop for `name`, with its browser
#   sugabots-desktop release name claimant                    `claimant` is done with `name`'s desktop
#   sugabots-desktop viewer name                              the viewer port of `name`'s desktop, if running
#   sugabots-desktop open browser|terminal|files   what the dock opens, on $DISPLAY
#
# `desktop` is what Sugabots runs when a person opens an agent's desktop, and
# `session` when the agent uses its browser. Both start the named desktop, or
# find it running: a display with a window manager and a dock, served to VNC
# viewers. `session` also starts the browser on it, or finds it running, and
# prints `display=N viewer=PORT watch=PORT browser=PORT started=yes|no
# password=P watch-password=P`, where `started` says whether the browser had
# to start; `desktop` prints the same without `browser`.
#
# The browser is Chromium driven by Playwright MCP, shown on the desktop so
# people watching see what the agent does, in Chromium's own sandbox where the
# sandbox it runs in allows user namespaces, with its profile under `profile`
# and its downloads and screenshots in `output`. It lives until the desktop
# stops, across the MCP sessions that drive it, and the dock's Browser starts
# it if the agent hasn't. Programs that stopped, as they do when a paused
# sandbox comes back, start again on the same display.
#
# Display N is served to VNC viewers over a WebSocket on port 5900+N, which
# `watch` reports too. It takes two passwords, made when the desktop starts:
# one to use the desktop, and one to only watch it, which logs in a viewer
# whose mouse and keys are ignored. Nothing else in the sandbox can use them,
# such as a page in the browser, which can't read the files they're kept in.
# Sugabots reads them from what `desktop` and `session` print. Its
# browser's MCP server is on port 8930+N, and the browser's DevTools on port
# 9230+N.
#
# A named desktop is claimed by what uses it, a turn or a person viewing it,
# given as `claimant` to `desktop` and `session` and given back by
# `release`. Each `desktop` or `session` with a claimant first stops the
# other named desktops that have gone unclaimed for IDLE_MINUTES minutes, so
# the desktops of threads that have gone quiet don't hold the sandbox's memory.
# A claim older than CLAIM_MINUTES minutes was never given back, as when
# Sugabots stops partway through a turn, and is dropped; a viewer claims its
# desktop again sooner. Desktops never claimed, such as those started by
# `start`, are never stopped this way.
set -euo pipefail

# Set here rather than relied on from the image: E2B runs commands without
# the image's ENV.
export LANG="${LANG:-C.UTF-8}"

state="${TMPDIR:-/tmp}/sugabots-desktop"
claims="$state/claims"
mkdir -p "$state/sessions" "$claims"
IDLE_MINUTES=15
CLAIM_MINUTES=60

free_display() {
	local n=1
	while [ -e "/tmp/.X11-unix/X$n" ] || [ -e "/tmp/.X$n-lock" ] || [ -n "$(grep -lx "$n" "$state"/sessions/* 2>/dev/null)" ]; do
		n=$((n + 1))
	done
	echo "$n"
}

# Whether every program of display N's `part`, desktop or browser, is running.
running() {
	local pids="$state/$1.$2.pids"
	[ -f "$pids" ] || return 1
	while read -r pid; do kill -0 "$pid" 2>/dev/null || return 1; done <"$pids"
}

desktop() {
	local n="$1" log="$state/$1.log" pids="$state/$1.desktop.pids"
	export DISPLAY=":$n"
	rm -f "/tmp/.X$n-lock" "/tmp/.X11-unix/X$n" "$state/$n.vnc"
	local password watch_password
	password="$(new_password)"
	watch_password="$(new_password)"
	(
		umask 077
		printf '%s\n%s\n' "$password" "$watch_password" >"$state/$n.passwords"
		# The second password logs in a viewer whose mouse and keys are ignored.
		vncpasswd -f <"$state/$n.passwords" >"$state/$n.passwd"
	)
	# The display and its VNC server in one, which sends viewers changes as
	# they happen rather than waiting for each to ask for the next, so a slow
	# connection delays frames rather than dropping most of them. It takes
	# viewers only on a socket nothing else in the sandbox can open, which
	# websockify serves. -ac: any program in this sandbox may draw on it. -s 0:
	# no screensaver, which would blank the screen after ten minutes without
	# keyboard or mouse input, and agents drive the browser through
	# Playwright, not the X server.
	Xvnc "$DISPLAY" -geometry 1280x800 -depth 24 -ac -s 0 -nolisten tcp \
		-rfbport -1 -rfbunixpath "$state/$n.vnc" -rfbunixmode 0600 \
		-SecurityTypes VncAuth -PasswordFile "$state/$n.passwd" -AlwaysShared >>"$log" 2>&1 &
	echo $! >"$pids"
	for _ in $(seq 50); do [ -S "$state/$n.vnc" ] && break; sleep 0.1; done
	websockify $((5900 + n)) --unix-target="$state/$n.vnc" >>"$log" 2>&1 &
	echo $! >>"$pids"
	# The dock matches windows to its apps through a service on the session bus.
	eval "$(dbus-launch --sh-syntax)"
	echo "$DBUS_SESSION_BUS_PID" >>"$pids"
	hsetroot -fill /usr/share/sugabots-desktop/wallpaper.png >>"$log" 2>&1
	openbox >>"$log" 2>&1 &
	echo $! >>"$pids"
	# For the dock's shadows and see-through background.
	xcompmgr -n >>"$log" 2>&1 &
	echo $! >>"$pids"
	# The dock's items are read from the home it runs with.
	mkdir -p "$HOME/.config/plank/dock1/launchers"
	cp -n /usr/share/sugabots-desktop/plank/*.dockitem "$HOME/.config/plank/dock1/launchers/"
	plank >>"$log" 2>&1 &
	echo $! >>"$pids"
}

# Eight characters, all VNC authentication reads of a password: 48 random bits.
new_password() {
	head -c 6 /dev/urandom | base64 | tr '+/' '-_'
}

# The passwords of display N's VNC servers, as `desktop` and `session` print them.
passwords() {
	local password watch_password
	{ read -r password; read -r watch_password; } <"$state/$1.passwords"
	echo "password=$password watch-password=$watch_password"
}

# Chromium's flags for its own sandbox. It needs user namespaces, which some
# sandboxes refuse (Docker's default seccomp profile does), and refuses to
# start as root with one; either way it runs without. --test-type leaves out
# the bar warning that --no-sandbox is on.
chromium_sandbox_flags() {
	if [ "$(id -u)" = 0 ] || ! unshare --user --map-root-user --pid --net --fork true 2>/dev/null; then
		echo "--no-sandbox --test-type"
	fi
}

# Chromium trusts the certificate authority the sandbox provider intercepts
# HTTPS with. OpenSandbox's credential proxy signs every site's certificate
# with its own, named in NODE_EXTRA_CA_CERTS, and Chromium trusts an added
# authority only from its store in the home, $HOME/.pki/nssdb. Without it,
# every site fails with ERR_CERT_AUTHORITY_INVALID.
#
# The home outlives the sandbox, so the authority of an earlier sandbox is
# removed first, and with no proxy none is left trusted: adding a certificate
# under a name already in the store keeps the old one beside it. Only the
# file's first certificate is added; OpenSandbox's holds one. Desktops for
# the same agent share the store, so they take turns.
trust_provider_authority() {
	local store="$HOME/.pki/nssdb" authority="${NODE_EXTRA_CA_CERTS:-}"
	mkdir -p "$store"
	(
		flock 9
		if [ -f "$store/cert9.db" ]; then
			while certutil -d "sql:$store" -D -n "$PROVIDER_AUTHORITY" 2>/dev/null; do :; done
		fi
		[ -r "$authority" ] || exit 0
		[ -f "$store/cert9.db" ] || certutil -d "sql:$store" -N --empty-password
		certutil -d "sql:$store" -A -t "C,," -n "$PROVIDER_AUTHORITY" -i "$authority"
	) 9>"$store/.sugabots-desktop.lock"
}
PROVIDER_AUTHORITY=sandbox-provider

# Chromium locks its profile with a link naming the machine and process using
# it. The profile is kept with the work, and a sandbox made again with the
# same work, as an upgrade makes, is another machine to Chromium, so it asks
# whether that machine still uses the profile instead of starting. Only this
# sandbox's own browser uses the profile, so a lock naming another machine is
# left over; one naming this machine is Chromium's to sort out.
unlock_profile() {
	local dir="$1/chromium" lock
	lock="$(readlink "$dir/SingletonLock" 2>/dev/null)" || return 0
	[ "${lock%-*}" = "$(hostname)" ] && return 0
	rm -f "$dir/SingletonLock" "$dir/SingletonSocket" "$dir/SingletonCookie"
}

browser() {
	local n="$1" profile="$2" output="$3" log="$state/$1.log" pids="$state/$1.browser.pids"
	local devtools=$((9230 + n))
	mkdir -p "$profile" "$output"
	unlock_profile "$profile"
	# A browser that warns about every site is better than none.
	trust_provider_authority >>"$log" 2>&1 ||
		echo "The browser couldn't be made to trust the sandbox provider's certificate authority." >>"$log"
	# Started here rather than by Playwright MCP, which closes a browser it
	# launched when its last client disconnects: at the end of every turn.
	# Maximized, so it stops at the dock. The profile is
	# found through XDG_CONFIG_HOME rather than --user-data-dir, which would
	# put its path in the windows' names, and the dock would no longer know
	# them as the Browser's.
	DISPLAY=":$n" XDG_CONFIG_HOME="$profile" chromium $(chromium_sandbox_flags) --start-maximized \
		--class=sugabots-browser \
		--remote-debugging-address=127.0.0.1 --remote-debugging-port="$devtools" \
		--no-first-run --no-default-browser-check about:blank >>"$log" 2>&1 &
	echo $! >"$pids"
	for _ in $(seq 100); do
		curl -sf -o /dev/null "http://127.0.0.1:$devtools/json/version" && break
		sleep 0.1
	done
	playwright-mcp --host 0.0.0.0 --port $((8930 + n)) --allowed-hosts '*' \
		--cdp-endpoint "http://127.0.0.1:$devtools" \
		--output-dir "$output" --file-paths absolute >>"$log" 2>&1 &
	echo $! >>"$pids"
	for _ in $(seq 100); do
		curl -s -o /dev/null "http://localhost:$((8930 + n))/mcp" && break
		sleep 0.1
	done
}

stop_part() {
	local pids="$state/$1.$2.pids"
	[ -f "$pids" ] || return 0
	xargs -r kill <"$pids" 2>/dev/null || true
	rm -f "$pids"
}

stop() {
	local n="${1:?which display}"
	stop_part "$n" browser
	stop_part "$n" desktop
}

# The display of the desktop named `name`, running, with where its browser
# keeps its profile and output recorded for the dock. Sets `desktop_started`.
named_desktop() {
	local name="$1" profile="$2" output="$3"
	local file="$state/sessions/$name"
	if [ -f "$file" ]; then n="$(cat "$file")"; else n="$(free_display)"; echo "$n" >"$file"; fi
	printf '%s\n%s\n' "$profile" "$output" >"$state/$n.browser-dirs"
	desktop_started=no
	if ! running "$n" desktop; then
		# The browser can't outlive the display it was on.
		stop "$n"
		desktop "$n"
		desktop_started=yes
	fi
}

# Claims the desktop named `name` for `claimant`, then stops every other
# named desktop that has gone unclaimed for IDLE_MINUTES. Claims are made and
# checked under one lock, so a desktop is never stopped as it is claimed.
claim_and_sweep() {
	local name="$1" claimant="$2"
	(
		flock 9
		mkdir -p "$claims/$name"
		touch "$claims/$name/$claimant"
		local dir other
		for dir in "$claims"/*/; do
			[ -d "$dir" ] || continue
			other="$(basename "$dir")"
			[ "$other" = "$name" ] && continue
			find "$dir" -mindepth 1 -mmin +"$CLAIM_MINUTES" -delete
			[ -z "$(ls -A "$dir")" ] || continue
			# Adding or removing a claim updates the directory's time, so it says
			# when the desktop was last given back.
			[ -n "$(find "$dir" -maxdepth 0 -mmin +"$IDLE_MINUTES")" ] || continue
			if [ -f "$state/sessions/$other" ]; then stop "$(cat "$state/sessions/$other")"; fi
			rmdir "$dir"
		done
	) 9>"$state/claims.lock"
}

release() {
	local name="${1:?name}" claimant="${2:?claimant}"
	(
		flock 9
		rm -f "$claims/$name/$claimant"
	) 9>"$state/claims.lock"
}

desktop_only() {
	if [ -n "${4:-}" ]; then claim_and_sweep "${1:?name}" "$4"; fi
	named_desktop "${1:?name}" "${2:?profile directory}" "${3:?output directory}"
	echo "display=$n viewer=$((5900 + n)) watch=$((5900 + n)) started=$desktop_started $(passwords "$n")"
}

session() {
	if [ -n "${4:-}" ]; then claim_and_sweep "${1:?name}" "$4"; fi
	named_desktop "${1:?name}" "${2:?profile directory}" "${3:?output directory}"
	local started=no
	if ! running "$n" browser; then
		stop_part "$n" browser
		browser "$n" "$2" "$3"
		started=yes
	fi
	echo "display=$n viewer=$((5900 + n)) watch=$((5900 + n)) browser=$((8930 + n)) started=$started $(passwords "$n")"
}

viewer() {
	local file="$state/sessions/${1:?name}"
	[ -f "$file" ] || exit 3
	local n
	n="$(cat "$file")"
	running "$n" desktop || exit 3
	echo $((5900 + n))
}

# What the dock opens on the desktop it runs on.
open() {
	local n="${DISPLAY#:}"
	case "${1:-}" in
	browser)
		local profile output
		{ read -r profile; read -r output; } <"$state/$n.browser-dirs"
		if running "$n" browser; then
			# The same profile reaches the running browser, which opens the window.
			XDG_CONFIG_HOME="$profile" exec chromium $(chromium_sandbox_flags) --new-window
		fi
		stop_part "$n" browser
		browser "$n" "$profile" "$output"
		;;
	terminal)
		exec lxterminal --working-directory=/workspace
		;;
	files) exec pcmanfm /workspace ;;
	*)
		echo "usage: sugabots-desktop open browser|terminal|files" >&2
		exit 2
		;;
	esac
}

case "${1:-}" in
start)
	n="${2:-$(free_display)}"
	desktop "$n"
	echo "DISPLAY=:$n"
	;;
stop) stop "${2:-}" ;;
desktop) desktop_only "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
session) session "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
release) release "${2:-}" "${3:-}" ;;
viewer) viewer "${2:-}" ;;
open) open "${2:-}" ;;
*)
	echo "usage: sugabots-desktop start [display] | stop display | desktop name profile output [claimant] | session name profile output [claimant] | release name claimant | viewer name | open browser|terminal|files" >&2
	exit 2
	;;
esac
