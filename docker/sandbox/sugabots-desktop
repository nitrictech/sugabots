#!/bin/bash
# The windows of agents' desktops in this sandbox, each app on a display of
# its own: Sugabots' web app draws the desktop around them, and shows each
# display in a window of its own, sized to it. Agents working at the same
# time never click on each other's windows.
#
#   sugabots-desktop start [display]                      start a bare display, print its DISPLAY
#   sugabots-desktop stop display                         stop it, and what runs on it
#   sugabots-desktop session name profile output folder   the browser and desktop server for `name`
#   sugabots-desktop files name folder                    the file manager for `name`, in `folder`
#   sugabots-desktop windows name                         the windows of `name`'s desktop, one a line
#   sugabots-desktop display name id                      where viewers reach one of those windows
#
# `session` is what Sugabots runs when the agent uses its browser or a person
# opens its desktop. It starts the browser's display, the browser and the
# desktop server, or finds them running, and prints `display=N viewer=PORT
# watch=PORT browser=PORT server=PORT started=yes|no password=P
# watch-password=P`, where `started` says whether the browser had to start.
#
# Each display holds one app, at the size of the window the web app shows it
# in: viewers resize the display, and its window manager keeps the app
# filling it. The browser draws no tabs or address bar of its own; the web
# app draws them, from the desktop server, which also runs the desktop's
# terminal and says which windows it has. A display an agent starts, run
# with SUGABOTS_DESKTOP_SESSION set to its `name`, is one of its windows too.
# `windows` prints `id=ID kind=browser|files|app display=N title=T` a line,
# the title last and to the end of its line; `display` prints `viewer=PORT
# password=P watch-password=P` for the window with that id.
#
# The browser is Chromium driven by Playwright MCP, in Chromium's own sandbox
# where the sandbox it runs in allows user namespaces, with its profile under
# `profile` and its downloads and screenshots in `output`. It lives until
# its display stops, across the MCP sessions that drive it. Programs that
# stopped, as they do when a paused sandbox comes back, start again on the
# same display.
#
# Display N is served to VNC viewers over a WebSocket on port 5900+N, which
# `watch` reports too. It takes two passwords, made when the display starts:
# one to use it, and one to only watch it, which logs in a viewer whose
# mouse and keys are ignored. Nothing else in the sandbox can use them, such
# as a page in the browser, which can't read the files they're kept in.
# Sugabots reads them from what `session` and `display` print. A browser's
# MCP server is on port 8930+N, its DevTools on port 9230+N, and the desktop
# server on 9530+N, behind the browser display's two passwords.
set -euo pipefail

# Set here rather than relied on from the image: E2B runs commands without
# the image's ENV.
export LANG="${LANG:-C.UTF-8}"

state="${TMPDIR:-/tmp}/sugabots-desktop"
mkdir -p "$state/sessions" "$state/started"

free_display() {
	local n=1
	while [ -e "/tmp/.X11-unix/X$n" ] || [ -e "/tmp/.X$n-lock" ] || [ -n "$(grep -lx "$n" "$state"/sessions/* 2>/dev/null)" ] || [ -e "$state/started/$n" ]; do
		n=$((n + 1))
	done
	echo "$n"
}

# Whether every program of display N's `part`, display, browser or app, is running.
running() {
	local pids="$state/$1.$2.pids"
	[ -f "$pids" ] || return 1
	while read -r pid; do kill -0 "$pid" 2>/dev/null || return 1; done <"$pids"
}

# Display N, served to VNC viewers, with a window manager that keeps
# windows on the screen as viewers resize it.
display() {
	local n="$1" log="$state/$1.log" pids="$state/$1.display.pids"
	export DISPLAY=":$n"
	rm -f "/tmp/.X$n-lock" "/tmp/.X11-unix/X$n" "$state/$n.vnc"
	local password watch_password
	password="$(new_password)"
	watch_password="$(new_password)"
	(
		umask 077
		printf '%s\n%s\n' "$password" "$watch_password" >"$state/$n.passwords"
		# The second password logs in a viewer whose mouse and keys are ignored.
		vncpasswd -f <"$state/$n.passwords" >"$state/$n.passwd"
	)
	# The display and its VNC server in one, which sends viewers changes as
	# they happen rather than waiting for each to ask for the next, so a slow
	# connection delays frames rather than dropping most of them. It takes
	# viewers only on a socket nothing else in the sandbox can open, which
	# websockify serves. -ac: any program in this sandbox may draw on it. -s 0:
	# no screensaver, which would blank the screen after ten minutes without
	# keyboard or mouse input, and agents drive the browser through
	# Playwright, not the X server.
	Xvnc "$DISPLAY" -geometry 1280x800 -depth 24 -ac -s 0 -nolisten tcp \
		-rfbport -1 -rfbunixpath "$state/$n.vnc" -rfbunixmode 0600 \
		-SecurityTypes VncAuth -PasswordFile "$state/$n.passwd" -AlwaysShared >>"$log" 2>&1 &
	echo $! >"$pids"
	for _ in $(seq 50); do [ -S "$state/$n.vnc" ] && break; sleep 0.1; done
	websockify $((5900 + n)) --unix-target="$state/$n.vnc" >>"$log" 2>&1 &
	echo $! >>"$pids"
	openbox >>"$log" 2>&1 &
	echo $! >>"$pids"
}

# Eight characters, all VNC authentication reads of a password: 48 random bits.
new_password() {
	head -c 6 /dev/urandom | base64 | tr '+/' '-_'
}

# The passwords of display N's VNC server, as `session` and `display` print them.
passwords() {
	local password watch_password
	{ read -r password; read -r watch_password; } <"$state/$1.passwords"
	echo "password=$password watch-password=$watch_password"
}

# Chromium's flags for its own sandbox. It needs user namespaces, which some
# sandboxes refuse (Docker's default seccomp profile does), and refuses to
# start as root with one; either way it runs without. --test-type leaves out
# the bar warning that --no-sandbox is on.
chromium_sandbox_flags() {
	if [ "$(id -u)" = 0 ] || ! unshare --user --map-root-user --pid --net --fork true 2>/dev/null; then
		echo "--no-sandbox --test-type"
	fi
}

# Chromium trusts the certificate authority the sandbox provider intercepts
# HTTPS with. OpenSandbox's credential proxy signs every site's certificate
# with its own, named in NODE_EXTRA_CA_CERTS, and Chromium trusts an added
# authority only from its store in the home, $HOME/.pki/nssdb. Without it,
# every site fails with ERR_CERT_AUTHORITY_INVALID.
#
# The home outlives the sandbox, so the authority of an earlier sandbox is
# removed first, and with no proxy none is left trusted: adding a certificate
# under a name already in the store keeps the old one beside it. Only the
# file's first certificate is added; OpenSandbox's holds one. Desktops for
# the same agent share the store, so they take turns.
trust_provider_authority() {
	local store="$HOME/.pki/nssdb" authority="${NODE_EXTRA_CA_CERTS:-}"
	mkdir -p "$store"
	(
		flock 9
		if [ -f "$store/cert9.db" ]; then
			while certutil -d "sql:$store" -D -n "$PROVIDER_AUTHORITY" 2>/dev/null; do :; done
		fi
		[ -r "$authority" ] || exit 0
		[ -f "$store/cert9.db" ] || certutil -d "sql:$store" -N --empty-password
		certutil -d "sql:$store" -A -t "C,," -n "$PROVIDER_AUTHORITY" -i "$authority"
	) 9>"$store/.sugabots-desktop.lock"
}
PROVIDER_AUTHORITY=sandbox-provider

# Chromium locks its profile with a link naming the machine and process using
# it. The profile is kept with the work, and a sandbox made again with the
# same work, as an upgrade makes, is another machine to Chromium, so it asks
# whether that machine still uses the profile instead of starting. Only this
# sandbox's own browser uses the profile, so a lock naming another machine is
# left over; one naming this machine is Chromium's to sort out.
unlock_profile() {
	local dir="$1/chromium" lock
	lock="$(readlink "$dir/SingletonLock" 2>/dev/null)" || return 0
	[ "${lock%-*}" = "$(hostname)" ] && return 0
	rm -f "$dir/SingletonLock" "$dir/SingletonSocket" "$dir/SingletonCookie"
}

browser() {
	local n="$1" profile="$2" output="$3" name="$4" folder="$5" log="$state/$1.log" pids="$state/$1.browser.pids"
	local devtools=$((9230 + n))
	mkdir -p "$profile" "$output"
	unlock_profile "$profile"
	# A browser that warns about every site is better than none.
	trust_provider_authority >>"$log" 2>&1 ||
		echo "The browser couldn't be made to trust the sandbox provider's certificate authority." >>"$log"
	# Started here rather than by Playwright MCP, which closes a browser it
	# launched when its last client disconnects: at the end of every turn.
	# In kiosk mode: filling the display, without tabs or an address bar,
	# which the web app draws. The profile is found through XDG_CONFIG_HOME,
	# where profiles from before have it, rather than --user-data-dir.
	DISPLAY=":$n" XDG_CONFIG_HOME="$profile" chromium $(chromium_sandbox_flags) --kiosk \
		--remote-debugging-address=127.0.0.1 --remote-debugging-port="$devtools" \
		--no-first-run --no-default-browser-check about:blank >>"$log" 2>&1 &
	echo $! >"$pids"
	for _ in $(seq 100); do
		curl -sf -o /dev/null "http://127.0.0.1:$devtools/json/version" && break
		sleep 0.1
	done
	playwright-mcp --host 0.0.0.0 --port $((8930 + n)) --allowed-hosts '*' \
		--cdp-endpoint "http://127.0.0.1:$devtools" \
		--output-dir "$output" --file-paths absolute >>"$log" 2>&1 &
	echo $! >>"$pids"
	for _ in $(seq 100); do
		curl -s -o /dev/null "http://localhost:$((8930 + n))/mcp" && break
		sleep 0.1
	done
	node /usr/local/lib/sugabots-desktop-server/server.mjs $((9530 + n)) "$devtools" "$state/$n.passwords" "$name" "$folder" >>"$log" 2>&1 &
	echo $! >>"$pids"
}

stop_part() {
	local pids="$state/$1.$2.pids"
	[ -f "$pids" ] || return 0
	xargs -r kill <"$pids" 2>/dev/null || true
	rm -f "$pids"
}

stop() {
	local n="${1:?which display}"
	stop_part "$n" app
	stop_part "$n" browser
	stop_part "$n" display
	rm -f "$state/started/$n"
}

# The display named `name`, running, making it if it isn't. Sets `n` and
# `display_started`.
named_display() {
	local name="$1"
	local file="$state/sessions/$name"
	if [ -f "$file" ]; then n="$(cat "$file")"; else n="$(free_display)"; echo "$n" >"$file"; fi
	display_started=no
	if ! running "$n" display; then
		# The browser can't outlive the display it was on.
		stop "$n"
		display "$n"
		display_started=yes
	fi
}

session() {
	named_display "${1:?name}"
	local profile="${2:?profile directory}" output="${3:?output directory}" folder="${4:?folder}" started=no
	if ! running "$n" browser; then
		stop_part "$n" browser
		browser "$n" "$profile" "$output" "$1" "$folder"
		started=yes
	fi
	echo "display=$n viewer=$((5900 + n)) watch=$((5900 + n)) browser=$((8930 + n)) server=$((9530 + n)) started=$started $(passwords "$n")"
}

files() {
	local name="${1:?name}" folder="${2:?folder}"
	named_display "$name.files"
	running "$n" app && return 0
	stop_part "$n" app
	DISPLAY=":$n" pcmanfm "$folder" >>"$state/$n.log" 2>&1 &
	echo $! >"$state/$n.app.pids"
}

# The title of the window in front on display N, if it has one.
title() {
	local active
	active="$(DISPLAY=":$1" xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | grep -o '0x[0-9a-f]*')" || return 0
	# _NET_WM_NAME where the app sets it, as most do; WM_NAME from older ones, such as xterm.
	DISPLAY=":$1" xprop -id "$active" _NET_WM_NAME WM_NAME 2>/dev/null | sed -n 's/^[A-Z_]*NAME([A-Z0-9_]*) = "\(.*\)"$/\1/p' | head -n 1
}

windows() {
	local name="${1:?name}" file n
	file="$state/sessions/$name"
	if [ -f "$file" ] && n="$(cat "$file")" && running "$n" browser; then
		echo "id=browser kind=browser display=$n title=$(title "$n")"
	fi
	file="$state/sessions/$name.files"
	if [ -f "$file" ] && n="$(cat "$file")" && running "$n" app; then
		echo "id=files kind=files display=$n title=$(title "$n")"
	fi
	for file in "$state"/started/*; do
		[ -f "$file" ] && [ "$(cat "$file")" = "$name" ] || continue
		n="${file##*/}"
		running "$n" display && echo "id=$n kind=app display=$n title=$(title "$n")"
	done
}

# The display of the window `id` of `name`'s desktop, if it's running.
display_of() {
	local name="$1" id="$2" file
	case "$id" in
	browser) file="$state/sessions/$name" ;;
	files) file="$state/sessions/$name.files" ;;
	*[!0-9]* | "") return 1 ;;
	*)
		[ "$(cat "$state/started/$id" 2>/dev/null)" = "$name" ] || return 1
		echo "$id"
		return 0
		;;
	esac
	[ -f "$file" ] && cat "$file"
}

display_viewer() {
	local n
	n="$(display_of "${1:?name}" "${2:?window}")" || exit 3
	running "$n" display || exit 3
	echo "viewer=$((5900 + n)) $(passwords "$n")"
}

case "${1:-}" in
start)
	n="${2:-$(free_display)}"
	# Shown on the desktop of the session that started it.
	echo "${SUGABOTS_DESKTOP_SESSION:-}" >"$state/started/$n"
	display "$n"
	echo "DISPLAY=:$n"
	;;
stop) stop "${2:-}" ;;
session) session "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
files) files "${2:-}" "${3:-}" ;;
windows) windows "${2:-}" ;;
display) display_viewer "${2:-}" "${3:-}" ;;
*)
	echo "usage: sugabots-desktop start [display] | stop display | session name profile output folder | files name folder | windows name | display name window" >&2
	exit 2
	;;
esac
