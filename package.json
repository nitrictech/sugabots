{
	"name": "sugabots",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"packages/*"
	],
	"catalog": {
		"@effect/platform-node": "4.0.0-rc.117",
		"@effect/sql-pg": "4.0.0-rc.117",
		"@types/pg": "^8.23.1",
		"better-auth": "^1.7.23",
		"drizzle-orm": "1.0.0-rc.5",
		"effect": "4.0.0-rc.117",
		"vite": "^8.2.2",
		"vite-plugin-static-copy": "^4.1.1"
	},
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"prepare": "effect-tsgo patch --typescript --no-oxlint",
		"check": "bun run lint && bun run typecheck && bun run test",
		"lint": "biome ci . && node lint/check-glossary.ts",
		"glossary:report": "node lint/check-glossary.ts --report",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
		"test": "vitest run",
		"build": "bun run --filter '*' build",
		"start:api": "bun run --cwd packages/server start",
		"dev": "portless",
		"storybook": "bun run --cwd packages/web storybook",
		"build:storybook": "bun run --cwd packages/web build:storybook",
		"test:storybook": "bun run --cwd packages/web test:storybook",
		"db:generate": "bun run --cwd packages/core db:generate",
		"db:push": "bun run --cwd packages/core db:push",
		"db:migrate": "bun run --cwd packages/core db:migrate",
		"db:studio": "bun run --cwd packages/core db:studio",
		"db:seed": "node --env-file-if-exists=.env packages/demo/src/development.ts",
		"db:seed:showcase": "node --env-file-if-exists=.env packages/demo/src/showcase/seed.ts",
		"build:computer": "docker build -t ghcr.io/nitrictech/sugabots-sandbox:latest -t sugabots-sandbox:dev docker/computer && node packages/core/src/chats/tools/browser/list-tools.ts && biome format --write packages/core/src/chats/tools/browser/playwright-tools.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@effect/tsgo": "^0.69.0",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-react": "^6.3.0",
		"drizzle-kit": "1.0.0-rc.5",
		"portless": "^0.17.0",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vitest": "^5.0.5"
	}
}
