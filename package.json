{
	"name": "sugabots",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"packages/*"
	],
	"catalog": {
		"@effect/sql-pg": "4.0.0-rc.115",
		"@types/pg": "^8.23.1",
		"better-auth": "^1.7.3",
		"drizzle-orm": "1.0.0-rc.5-5935859",
		"effect": "4.0.0-rc.115",
		"hono": "^4.13.7",
		"vite": "^8.2.2"
	},
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"prepare": "effect-tsgo patch --typescript --no-oxlint",
		"check": "bun run lint && bun run typecheck && bun run test",
		"lint": "biome ci .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
		"test": "vitest run",
		"build": "bun run --filter '*' build",
		"start:api": "bun run --cwd packages/server start",
		"dev": "bun run telemetry daemon > /dev/null || echo 'motel did not start: traces are not being collected'; portless",
		"storybook": "bun run --cwd packages/web storybook",
		"build:storybook": "bun run --cwd packages/web build:storybook",
		"test:storybook": "bun run --cwd packages/web test:storybook",
		"db:generate": "bun run --cwd packages/core db:generate",
		"db:push": "bun run --cwd packages/core db:push",
		"db:migrate": "bun run --cwd packages/core db:migrate",
		"db:studio": "bun run --cwd packages/core db:studio",
		"db:seed": "node --env-file-if-exists=.env packages/server/src/seed.ts",
		"telemetry": "MOTEL_RUNTIME_DIR=.motel MOTEL_OTEL_BASE_URL=http://127.0.0.1:27687 MOTEL_OTEL_SERVICE_NAME=sugabots motel",
		"explore:traces": "bun run telemetry"
	},
	"overrides": {
		"@effect/platform-node-shared": "4.0.0-beta.90"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@effect/tsgo": "^0.45.0",
		"@kitlangton/motel": "0.2.8",
		"@types/node": "^26.5.0",
		"@vitejs/plugin-react": "^6.1.1",
		"drizzle-kit": "1.0.0-rc.5-5935859",
		"portless": "^0.15.6",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vitest": "^5.0.0"
	}
}
